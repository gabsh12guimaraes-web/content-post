    {
      "id": "d6729b7b-57c6-4c2b-81f4-4187dfde3131",
      "name": "Montar pedido de ajuste",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2640,
        340
      ],
      "parameters": {
        "jsCode": "const SYSTEM = \"Você está revisando um post da marca descrita em <marca>, a pedido da pessoa responsável pela marca.\\n\\nRegras:\\n1. Faça EXATAMENTE o que <comentario> pede. Não \\\"melhore\\\" outras partes por conta própria.\\n2. Tudo o que o comentário não menciona fica idêntico, caractere por caractere.\\n3. Se o comentário for ambíguo, escolha a interpretação mais provável e explique em \\\"resumo_mudancas\\\".\\n4. Se o pedido violar <marca><evitar>, não aplique essa parte e explique em \\\"resumo_mudancas\\\".\\n5. Continue seguindo o tom de voz, o idioma (<marca><idioma>) e as regras de formato da marca.\\n6. Se mudou o conteúdo de um slide que tem imagem, avalie se o prompt de imagem também precisa mudar. Liste em \\\"alterou_imagens\\\" só os slides cuja IMAGEM precisa ser gerada de novo.\\n\\nResponda APENAS com um objeto JSON com os mesmos campos da versão atual (legenda, hashtags, slides, cenas, prompts_imagem) mais:\\n\\\"alterou_legenda\\\": true|false, \\\"alterou_slides\\\": [números], \\\"alterou_imagens\\\": [números], \\\"resumo_mudancas\\\": \\\"frase curta dizendo o que mudou\\\"\";\nconst idiomaDe = m => (m.Idioma && m.Idioma.name) || m.Idioma || 'Português (Brasil)';\nconst cfg = $('Config').first().json;\nconst marca = (($json.records || [])[0] || {}).fields || {};\nconst post = $('Buscar post').first().json.fields;\nconst atual = JSON.parse(post.Conteudo || '{}');\nfor (const k of ['alterou_legenda', 'alterou_slides', 'alterou_imagens', 'resumo_mudancas']) delete atual[k];\nconst user = [\n  '<marca>',\n  '<tom_de_voz>' + (marca.TomDeVoz || '') + '</tom_de_voz>',\n  '<idioma>' + idiomaDe(marca) + '</idioma>',\n  '<evitar>' + (marca.Evitar || '') + '</evitar>',\n  '</marca>',\n  '',\n  '<versao_atual numero=\"' + (post.Versao || 1) + '\">', JSON.stringify(atual, null, 1), '</versao_atual>',\n  '',\n  '<historico>', post.HistoricoAjustes || '', '</historico>',\n  '',\n  '<comentario>', $('Entender mensagem').first().json.comentario, '</comentario>',\n].join('\\n');\nreturn [{ json: { body: {\n  model: cfg.modelo, max_tokens: 16000, output_config: { effort: 'medium' }, fallbacks: 'default',\n  system: SYSTEM, messages: [{ role: 'user', content: user }],\n} } }];"
      }
    },
