    {
      "id": "9769bd49-4035-449d-b538-2f1ecb037268",
      "name": "Entender mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst u = $('Telegram: cliques e respostas').first().json;\nconst cb = u.callback_query;\nif (cb) {\n  if (String(cb.message && cb.message.chat && cb.message.chat.id) !== String(cfg.telegramChatId)) return [];\n  const [acao, id] = String(cb.data || '').split(':');\n  if (!id) return [];\n  return [{ json: { aprovar: acao === 'aprovar', pedir: acao === 'ajustar', id, queryId: cb.id } }];\n}\nconst m = u.message;\nif (!m || String(m.chat && m.chat.id) !== String(cfg.telegramChatId) || !m.text) return [];\nconst achou = String((m.reply_to_message && m.reply_to_message.text) || '').match(/\\[(rec[A-Za-z0-9]{14})\\]/);\nif (!achou) return [];\nreturn [{ json: { aprovar: false, pedir: false, id: achou[1], comentario: m.text } }];"
      }
    },
