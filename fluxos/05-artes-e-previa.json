      "id": "9f37a311-b84e-4ac8-acac-1b5e1ae16eec",
      "name": "Ver imagens que faltam",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "const f = $json.fields;\nif (['Reels', 'Stories'].includes(f.Formato)) return [{ json: { gerar: false } }];\nconst c = JSON.parse(f.Conteudo || '{}');\nconst regerar = f.ImagensRegerar ? JSON.parse(f.ImagensRegerar) : null;\nconst atuais = f.ImagensSlides ? JSON.parse(f.ImagensSlides) : {};\nconst PROPORCAO = { '4:5': 'social_post_4_5', '1:1': 'square_1_1', '9:16': 'social_story_9_16', '16:9': 'widescreen_16_9' };\nconst pedidos = (c.prompts_imagem || []).filter(x => (regerar && regerar.length) ? regerar.includes(x.slide) : !atuais[x.slide]);\nif (!pedidos.length) return [{ json: { gerar: false } }];\nreturn pedidos.map(x => ({ json: { gerar: true, slide: x.slide, prompt: x.prompt, aspect_ratio: PROPORCAO[x.proporcao] || 'social_post_4_5' } }));"
      }
    },
