      ],
      "parameters": {
        "jsCode": "const d = $json.data || {};\nconst pronto = d.status === 'COMPLETED' || d.status === 'FAILED' || !!$json.error || $runIndex > 300;\nreturn [{ json: { pronto, slide: $('Uma imagem por vez').first().json.slide, url: d.status === 'COMPLETED' ? (d.generated || [])[0] : null } }];"
      }
    },
