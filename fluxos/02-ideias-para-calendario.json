    {
      "id": "b3815127-03f2-437e-8cf6-e6e57c221053",
      "name": "Buscar datas ocupadas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://api.airtable.com/v0/' + $('Config').first().json.airtableBase + '/Calendario' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "airtableTokenApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "filterByFormula",
              "value": "IS_AFTER({DataPublicacao}, NOW())"
            },
            {
              "name": "pageSize",
              "value": "100"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "credentials": {
        "airtableTokenApi": {
          "name": "Airtable"
        }
      },
      "executeOnce": true
    },
    {
      "id": "ebc8f6f3-bffa-4c6f-ad30-243fc900e186",
      "name": "Escolher datas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst ideias = $('Buscar ideias aprovadas').first().json.records || [];\nif (!ideias.length) return [];\nconst [hh, mm] = cfg.fuso.slice(1).split(':').map(Number);\nconst offMin = (cfg.fuso[0] === '-' ? -1 : 1) * (hh * 60 + mm);\nconst diaLocal = iso => new Date(Date.parse(iso) + offMin * 60000).toISOString().slice(0, 10);\nconst ocupados = new Set(($('Buscar datas ocupadas').first().json.records || []).filter(r => r.fields.DataPublicacao).map(r => diaLocal(r.fields.DataPublicacao)));\nconst d = new Date(Date.now() + offMin * 60000);\nconst registros = ideias.map(r => {\n  do { d.setUTCDate(d.getUTCDate() + 1); } while (d.getUTCDay() === 0 || ocupados.has(d.toISOString().slice(0, 10)));\n  const dia = d.toISOString().slice(0, 10);\n  ocupados.add(dia);\n  const f = r.fields;\n  return { fields: {\n    Titulo: f.Titulo, Ideia: [r.id], DataPublicacao: dia + 'T' + cfg.horarioPadrao + ':00' + cfg.fuso,\n    Rede: f.Rede, Formato: f.Formato, Pilar: f.Pilar, Status: 'Planejado', Versao: 1,\n  } };\n});\nconst out = [];\nfor (let k = 0; k < registros.length; k += 10) out.push({ json: { body: { records: registros.slice(k, k + 10), typecast: true } } });\nreturn out;"
      }
    },
    {
      "id": "5a2f1578-c506-41e4-93c3-4f3c7ad71454",
      "name": "Criar posts no calendário",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://api.airtable.com/v0/' + $('Config').first().json.airtableBase + '/Calendario' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "airtableTokenApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 120000
        }
      },
      "credentials": {
        "airtableTokenApi": {
          "name": "Airtable"
        }
      }
    },
    {
      "id": "01dd693b-ad3e-491e-b3cd-6231de96bf05",
      "name": "Resumo do calendário",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "jsCode": "const posts = $input.all().flatMap(i => i.json.records || []);\nconst linhas = posts.map(p => '• ' + new Date(p.fields.DataPublicacao).toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo', weekday: 'short', day: '2-digit', month: '2-digit' }) + ': ' + p.fields.Titulo);\nreturn [{ json: { texto: '🗓️ ' + posts.length + ' post(s) no calendário:\\n' + linhas.join('\\n') } }];"
      }
    },
    {
