    {
      "id": "c35559fc-bf09-48a6-ab1f-241e847ba824",
      "name": "Buscar posts da vez",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://api.airtable.com/v0/' + $('Config').first().json.airtableBase + '/Calendario' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "airtableTokenApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "filterByFormula",
              "value": "AND({Status}='Agendado', IS_BEFORE({DataPublicacao}, DATEADD(NOW(), 15, 'minutes')))"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "credentials": {
        "airtableTokenApi": {
          "name": "Airtable"
        }
      }
    },
    {
      "id": "8d03ba50-2cd0-4d34-8bd7-143c674115e5",
      "name": "Montar publicações",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "const REDES = { Instagram: 'instagram', TikTok: 'tiktok', LinkedIn: 'linkedin', YouTube: 'youtube' };\nreturn (($input.first().json.records) || []).map(r => {\n  const f = r.fields;\n  const body = {\n    post: [f.Legenda, f.Hashtags].filter(Boolean).join('\\n\\n'),\n    platforms: [REDES[f.Rede]].filter(Boolean),\n    mediaUrls: (f.Arquivos || []).map(a => a.url),\n  };\n  if (['Reels', 'Stories'].includes(f.Formato)) body.isVideo = true;\n  if (f.Rede === 'Instagram' && f.Formato === 'Reels') body.instagramOptions = { reels: true, shareReelsFeed: true };\n  if (f.Rede === 'Instagram' && f.Formato === 'Stories') body.instagramOptions = { stories: true };\n  if (f.Rede === 'YouTube') body.youTubeOptions = { title: String(f.Titulo).slice(0, 100), visibility: 'public' };\n  return { json: { id: r.id, titulo: f.Titulo, body } };\n});"
      }
    },
    {
      "id": "c4913cdb-56f6-45e6-ad19-0189c9cdd1af",
      "name": "Ayrshare: publicar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://api.ayrshare.com/api/post' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 300000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Ayrshare"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "1a27b196-ac20-4808-a6fb-39694174a672",
      "name": "Ler resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "jsCode": "const p = $('Montar publicações').item.json;\nconst r = $json;\nconst ok = r.status === 'success';\nconst link = (r.postIds || []).map(x => x.postUrl).filter(Boolean)[0] || null;\nreturn { json: { id: p.id, titulo: p.titulo, ok, link, idPublicacao: r.id || '', erro: ok ? '' : JSON.stringify(r.errors || r.error || r).slice(0, 500) } };",
        "mode": "runOnceForEachItem"
      }
    },
    {
      "id": "7383c986-c304-4175-99dd-57af786bda74",
      "name": "Atualizar status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "method": "PATCH",
        "url": "={{ 'https://api.airtable.com/v0/' + $('Config').first().json.airtableBase + '/Calendario' + '/' + $json.id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "airtableTokenApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ fields: { Status: $json.ok ? 'Publicado' : 'Erro', LinkPublicado: $json.link, IdAgendamento: $json.idPublicacao } }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "credentials": {
        "airtableTokenApi": {
          "name": "Airtable"
        }
      }
    },
    {
      "id": "7f068e95-09ac-434b-9283-4f827578a5cb",
      "name": "Avisar no Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "chatId": "={{ $('Config').first().json.telegramChatId }}",
        "text": "={{ $('Ler resultado').item.json.ok ? '📣 Publicado: \"' + $('Ler resultado').item.json.titulo + '\"' + ($('Ler resultado').item.json.link ? '\\n' + $('Ler resultado').item.json.link : '') : '❌ Falhou ao publicar \"' + $('Ler resultado').item.json.titulo + '\": ' + $('Ler resultado').item.json.erro + '\\nCorrija e mude o status para Agendado de novo.' }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "telegramApi": {
          "name": "Telegram"
        }
      }
    }
